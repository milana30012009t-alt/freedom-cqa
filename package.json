{
  "name": "freedom-cqa",
  "version": "1.0.0",
  "description": "Conversation Quality Analytics for Freedom Broker — evidence-first evaluation of operator dialogs (RU/KZ/EN) with appeals and human review",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.15"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
