# Скопируйте в .env (cp .env.example .env) и заполните. Файл .env не попадает в Git.

# --- Сервер ---
PORT=3000
HOST=127.0.0.1

# --- Данные организаторов (GET API по group_id) ---
# Вставьте адрес кнопки «Открыть GET для DEV» из PDF-задания. Параметр group_id приложение
# подставляет само из DATASET_GROUP_ID или из поля в разделе «Данные». Ссылка подписана (sig=...):
# не публикуйте её и не коммитьте.
DATASET_API_URL=
DATASET_GROUP_ID=DEV
# Загрузить набор из API при первом запуске, если локальных данных ещё нет
DATASET_AUTOLOAD=true

# --- AI-модель ---
# auto: Claude, если задан ANTHROPIC_API_KEY; иначе OpenAI-совместимая модель, если задан OPENAI_MODEL;
# иначе — офлайн-движок правил. Можно принудительно: anthropic | openai | rules
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high (пусто — не отправлять)
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000

# OpenAI или локальная модель через OpenAI-совместимый API (например, Ollama):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:14b
# OPENAI_RESPONSE_FORMAT=json_object
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSE_FORMAT=json_schema

# Если AI недоступен — оценить офлайн-правилами (оценка будет помечена)
AI_FALLBACK_TO_RULES=true
AI_CONCURRENCY=3

# Цены для оценки стоимости, USD за 1 млн токенов (по умолчанию — Claude Sonnet 5.5)
AI_PRICE_INPUT_PER_MTOK=2
AI_PRICE_OUTPUT_PER_MTOK=10
AI_PRICE_CACHE_READ_PER_MTOK=0.1
AI_PRICE_CACHE_WRITE_PER_MTOK=2.5

# --- Встраивание в Microsoft Dynamics 365 ---
# Разрешённые источники для API (через запятую), если интерфейс открыт с другого домена
CORS_ORIGINS=
FRAME_ANCESTORS='self' https://*.dynamics.com
